{
  "expo": {
    "name": "日月表",
    "slug": "school-timetable",
    "version": "1.0.2",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.2",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-screen.jpg",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.daydayup.schooltimetable",
      "versionCode": 3,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#F3F5FB",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "updateNotes": "新增学校课表一键导入，优化课程高度、作息时间和通识课备注，并改进教室地点显示。",
      "eas": {
        "projectId": "d28c8a18-dfb9-4a4a-99eb-20b2a9e7a348"
      }
    },
    "owner": "zixia-12",
    "updates": {
      "url": "https://u.expo.dev/d28c8a18-dfb9-4a4a-99eb-20b2a9e7a348"
    }
  }
}
